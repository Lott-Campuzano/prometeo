---
/**
 * Plantilla base de todas las páginas.
 *
 * Centraliza el idioma, las fuentes locales, los metadatos, la cabecera, el
 * pie y el script del tema. El CSS global se importa aquí una sola vez.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config.js';

const {
  title,
  description = SITE.description,
  current = 'inicio',
  mainClass = '',
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2fbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#031413" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <Header current={current} />

    <main id="contenido" class={mainClass}>
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/theme.js';
    </script>
  </body>
</html>
