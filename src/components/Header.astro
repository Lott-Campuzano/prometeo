---
/**
 * Cabecera fija.
 *
 * «Líneas de ayuda» es un enlace real a `/ayuda`: si JavaScript está
 * desactivado, funciona igual. En la página principal, el script intercepta
 * el clic y abre el diálogo con los mismos datos.
 */
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const { current = 'inicio' } = Astro.props;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Prometeo, volver al inicio">Prometeo</a>

    <nav class="nav" aria-label="Principal">
      <a
        class="nav-link"
        href="/ayuda"
        data-crisis-link
        aria-label="Líneas de ayuda"
        aria-current={current === 'ayuda' ? 'page' : undefined}
      >
        <Icon name="help" size={18} />
        <span class="nav-label">Líneas de ayuda</span>
      </a>

      <ThemeToggle />
    </nav>
  </div>
</header>
