# Copia este archivo a .env para desarrollo local.
# En Vercel, configura estas variables en Project → Settings → Environment Variables.
# El archivo .env nunca debe subirse al repositorio.

# Obligatoria. Vive solo en el servidor: nunca se expone al navegador.
OPENAI_API_KEY=

# Opcionales
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Peticiones por minuto y por instancia (límite en memoria, mejor esfuerzo).
RATE_LIMIT_PER_MINUTE=20
