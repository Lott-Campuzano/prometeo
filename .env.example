# Copia este archivo a .env y pon tu clave real.
# El archivo .env nunca debe subirse al repositorio.

OPENAI_API_KEY=sk-tu-clave-aqui

# Modelo a usar (opcional)
OPENAI_MODEL=gpt-4o-mini

# Puerto del servidor (opcional)
PORT=3000

# Límite de mensajes por minuto y por IP (opcional)
RATE_LIMIT_PER_MINUTE=20

# Si está detrás de un proxy inverso, indica el número de saltos (opcional)
# TRUST_PROXY=1
